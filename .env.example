# VitalLink Healthcare Environment Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication Secrets
JWT_SECRET=vitallink-healthcare-ultra-secure-jwt-secret-2026
JWT_REFRESH_SECRET=vitallink-healthcare-ultra-secure-refresh-token-2026

# Optional External PostgreSQL Database URL
# If left unset, VitalLink seamlessly uses the robust embedded file-persisted relational DB in ./data/vitallink_db.json
DATABASE_URL=postgres://user:password@localhost:5432/vitallink_db

# Gemini API Key (if AI extensions enabled)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
